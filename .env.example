# Server-side only: Groq API credentials
# Never prefix with NEXT_PUBLIC_ to prevent leaking into client bundles
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Groq model used for rewrites
GROQ_MODEL=openai/gpt-oss-120b

# Input length limit in characters (must equal MAX_INPUT_CHARS in src/lib/limits.ts)
MAX_INPUT_CHARS=8000
